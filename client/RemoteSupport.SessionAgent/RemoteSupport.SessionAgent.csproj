<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <TargetPlatformSdkPath>C:\Program Files (x86)\Windows Kits\10\</TargetPlatformSdkPath>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RotaLink</AssemblyName>
    <Version>0.4.4</Version>
    <AssemblyVersion>0.4.4.0</AssemblyVersion>
    <FileVersion>0.4.4.0</FileVersion>
    <InformationalVersion>0.4.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\RotaLink.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PortableBuild)' == 'true'"><DefineConstants>$(DefineConstants);PORTABLE_BUILD</DefineConstants></PropertyGroup>
  <ItemGroup><Compile Remove="SelfInstaller.cs;NativeConsentPrompt.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><Reference Include="System.Web.Extensions" /><Reference Include="System.Net.Http" /></ItemGroup>
</Project>
