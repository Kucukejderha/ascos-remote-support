<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <TargetPlatformSdkPath>C:\Program Files (x86)\Windows Kits\10\</TargetPlatformSdkPath>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RotaLink</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RotaLink.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PortableBuild)' == 'true'"><DefineConstants>$(DefineConstants);PORTABLE_BUILD</DefineConstants></PropertyGroup>
  <ItemGroup><Compile Remove="SelfInstaller.cs;NativeConsentPrompt.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><Reference Include="System.Web.Extensions" /><Reference Include="System.Net.Http" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteSupport.Protocol\RemoteSupport.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\RemoteSupport.Service\bin\$(Configuration)\net48\RotaLink.Service.exe"
                      LogicalName="RotaLink.Runtime.Service.exe"
                      Condition="Exists('..\RemoteSupport.Service\bin\$(Configuration)\net48\RotaLink.Service.exe')" />
    <EmbeddedResource Include="..\RotaLink.SessionHelper\bin\$(Configuration)\net48\RotaLink.SessionHelper.exe"
                      LogicalName="RotaLink.Runtime.SessionHelper.exe"
                      Condition="Exists('..\RotaLink.SessionHelper\bin\$(Configuration)\net48\RotaLink.SessionHelper.exe')" />
    <EmbeddedResource Include="..\..\native\build\x64\RotaLink.NativeCapture.exe"
                      LogicalName="RotaLink.Runtime.NativeCapture.exe"
                      Condition="Exists('..\..\native\build\x64\RotaLink.NativeCapture.exe')" />
    <EmbeddedResource Include="..\RemoteSupport.Protocol\bin\$(Configuration)\net48\*.dll"
                      LogicalName="RotaLink.Runtime.%(Filename)%(Extension)"
                      Condition="Exists('..\RemoteSupport.Protocol\bin\$(Configuration)\net48\System.Memory.dll')" />
  </ItemGroup>
</Project>
