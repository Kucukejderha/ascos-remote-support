<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>RotaLink.SessionHelper</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetPlatformSdkPath>C:\Program Files (x86)\Windows Kits\10\</TargetPlatformSdkPath>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SessionKeepAlive.cs" />
    <Compile Include="InteractiveWindowStation.cs" />
    <Compile Include="InputDesktop.cs" />
    <Compile Include="InputEngine.cs" />
    <Compile Include="InputPipeServer.cs" />
    <Compile Include="NativeCaptureBridge.cs" />
    <Compile Include="SharedFrameReader.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteSupport.Protocol\RemoteSupport.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\RemoteSupport.Protocol\bin\$(Configuration)\net48\*.dll"
                      LogicalName="RotaLink.Runtime.%(Filename)%(Extension)"
                      Condition="Exists('..\RemoteSupport.Protocol\bin\$(Configuration)\net48\System.Memory.dll')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
